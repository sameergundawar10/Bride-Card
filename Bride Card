  <!-- YouTube IFrame API for Muzhumathi (Instrumental) -->
  <script src="https://www.youtube.com/iframe_api"></script>
  <script>
    // =========================================================================
    // CHANGE BRIDE NAME HERE IF NEEDED ("प्रियंका" or "पायल")
    // =========================================================================
    const BRIDE_NAME = "प्रियंका";
    document.querySelectorAll('.bride-name-slot').forEach(el => el.textContent = BRIDE_NAME);

    // 1. YouTube Audio Setup (isOZo5ONtdg)
    let ytPlayer;
    let musicPlaying = false;

    function onYouTubeIframeAPIReady() {
      ytPlayer = new YT.Player('ytplayer', {
        height: '1',
        width: '1',
        videoId: 'isOZo5ONtdg',
        playerVars: {
          'autoplay': 0,
          'controls': 0,
          'loop': 1,
          'playlist': 'isOZo5ONtdg',
          'playsinline': 1
        }
      });
    }

    function openEnvelope() {
      const env = document.getElementById('envelope-screen');
      env.classList.add('opening');

      if (ytPlayer && typeof ytPlayer.playVideo === 'function') {
        ytPlayer.unMute();
        ytPlayer.setVolume(100);
        ytPlayer.playVideo();
        musicPlaying = true;
      }

      setTimeout(() => {
        env.style.opacity = '0';
        env.style.visibility = 'hidden';
      }, 950);
    }

    function toggleMusic() {
      const fab = document.getElementById('musicFab');
      if (!ytPlayer || typeof ytPlayer.pauseVideo !== 'function') return;
      if (musicPlaying) {
        ytPlayer.pauseVideo();
        fab.textContent = '🔇';
        musicPlaying = false;
      } else {
        ytPlayer.playVideo();
        fab.textContent = '🎵';
        musicPlaying = true;
      }
    }

    // 2. Falling Flower Petals Canvas Animation
    const pCanvas = document.getElementById('petals-canvas');
    const pCtx = pCanvas.getContext('2d');
    let petals = [];

    function resizePetals() {
      pCanvas.width = Math.min(window.innerWidth, 430);
      pCanvas.height = window.innerHeight;
    }
    window.addEventListener('resize', resizePetals);
    resizePetals();

    for (let i = 0; i < 18; i++) {
      petals.push({
        x: Math.random() * pCanvas.width,
        y: Math.random() * pCanvas.height,
        r: 4 + Math.random() * 5,
        vy: 0.7 + Math.random() * 1.1,
        vx: -0.4 + Math.random() * 0.8,
        angle: Math.random() * Math.PI * 2,
        color: i % 2 === 0 ? 'rgba(244, 164, 176, 0.65)' : 'rgba(246, 210, 110, 0.6)'
      });
    }

    function drawPetals() {
      pCtx.clearRect(0, 0, pCanvas.width, pCanvas.height);
      petals.forEach(p => {
        p.y += p.vy;
        p.x += p.vx + Math.sin(p.angle) * 0.3;
        p.angle += 0.02;
        if (p.y > pCanvas.height) { p.y = -10; p.x = Math.random() * pCanvas.width; }
        pCtx.save();
        pCtx.translate(p.x, p.y);
        pCtx.rotate(p.angle);
        pCtx.fillStyle = p.color;
        pCtx.beginPath();
        pCtx.ellipse(0, 0, p.r, p.r * 0.6, 0, 0, Math.PI * 2);
        pCtx.fill();
        pCtx.restore();
      });
      requestAnimationFrame(drawPetals);
    }
    drawPetals();

    // 3. Interactive Wedding Card Modal
    function openWeddingModal() {
      document.getElementById('modal-wedding').classList.add('active');
      document.getElementById('wedding-cover').classList.remove('hidden');
    }

    function closeWeddingModal() {
      document.getElementById('modal-wedding').classList.remove('active');
    }

    function hideWeddingCover() {
      document.getElementById('wedding-cover').classList.add('hidden');
    }

    // 4. Team Bride / Groom Selector
    function selectTeam(side) {
      document.getElementById('teamBrideBtn').classList.toggle('active', side === 'bride');
      document.getElementById('teamGroomBtn').classList.toggle('active', side === 'groom');
      const status = document.getElementById('teamStatusText');
      if (side === 'bride') {
        status.innerHTML = `🎉 तुम्ही वधू पक्षाकडून (Team Bride — ${BRIDE_NAME}) आहात!`;
      } else {
        status.innerHTML = `🎉 तुम्ही वर पक्षाकडून (Team Groom — कौस्तुभ) आहात!`;
      }
    }

    // 5. Countdown Timer to Jan 4, 2027 10:42 AM IST
    const weddingTime = new Date("2027-01-04T10:42:00+05:30").getTime();
    function updateTimer() {
      const diff = weddingTime - new Date().getTime();
      if (diff <= 0) return;
      document.getElementById('cd-d').textContent = Math.floor(diff / (1000 * 60 * 60 * 24));
      document.getElementById('cd-h').textContent = String(Math.floor((diff / (1000 * 60 * 60)) % 24)).padStart(2, '0');
      document.getElementById('cd-m').textContent = String(Math.floor((diff / (1000 * 60)) % 60)).padStart(2, '0');
      document.getElementById('cd-s').textContent = String(Math.floor((diff / 1000) % 60)).padStart(2, '0');
    }
    setInterval(updateTimer, 1000);
    updateTimer();
  </script>
